#version 310 es

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputCells {
    uint cells_in[];
};

layout(std430, binding = 1) writeonly buffer OutputCells {
    uint cells_out[];
};

layout(std430, binding = 2) buffer BurningCount {
    uint burning_count;
};

uniform uint grid_size;
uniform uint epoch;

shared uint tile[18][18];
shared uint workgroup_burning_count;

uint random_value(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

void main() {
    uvec2 local = gl_LocalInvocationID.xy;
    uvec2 group_origin = gl_WorkGroupID.xy * 16u;
    uint local_index = local.y * 16u + local.x;

    /* Load the 16x16 tile and its one-cell halo cooperatively. */
    for (uint halo_index = local_index; halo_index < 324u; halo_index += 256u) {
        uint halo_x = halo_index % 18u;
        uint halo_y = halo_index / 18u;
        int global_x = int(group_origin.x + halo_x) - 1;
        int global_y = int(group_origin.y + halo_y) - 1;
        if (global_x >= 0 && global_y >= 0 &&
            global_x < int(grid_size) && global_y < int(grid_size)) {
            tile[halo_y][halo_x] =
                cells_in[uint(global_y) * grid_size + uint(global_x)];
        } else {
            tile[halo_y][halo_x] = 2u;
        }
    }
    if (local_index == 0u) {
        workgroup_burning_count = 0u;
    }
    barrier();

    uvec2 position = gl_GlobalInvocationID.xy;
    bool in_bounds = position.x < grid_size && position.y < grid_size;
    uint next = 2u;

    if (in_bounds) {
        uint index = position.y * grid_size + position.x;
        uint current = tile[local.y + 1u][local.x + 1u];
        next = current;

        if (current == 1u) {
            next = 2u;
        } else if (current == 0u) {
            uint neighbor_is_burning =
                uint(tile[local.y][local.x] == 1u) |
                uint(tile[local.y][local.x + 1u] == 1u) |
                uint(tile[local.y][local.x + 2u] == 1u) |
                uint(tile[local.y + 1u][local.x] == 1u) |
                uint(tile[local.y + 1u][local.x + 2u] == 1u) |
                uint(tile[local.y + 2u][local.x] == 1u) |
                uint(tile[local.y + 2u][local.x + 1u] == 1u) |
                uint(tile[local.y + 2u][local.x + 2u] == 1u);
            uint random_sample =
                random_value(index + epoch * 0x9e3779b9u);
            /* 0.15 * 2^32, avoiding an integer division/modulo. */
            if (neighbor_is_burning != 0u && random_sample < 644245094u) {
                next = 1u;
            }
        }

        cells_out[index] = next;
        if (next == 1u) {
            atomicAdd(workgroup_burning_count, 1u);
        }
    }
    barrier();
    if (local_index == 0u) {
        atomicAdd(burning_count, workgroup_burning_count);
    }
}
